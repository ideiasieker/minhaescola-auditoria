# Cole no painel "Environment" do Easypanel. Nunca commitar valores reais.
# Senhas: openssl rand -hex 24
IMAGEM_TAG=sha-xxxxxxx
# Imagem do banco com pgBackRest, do repo minhaescola (tag de um build da main).
IMAGEM_POSTGRES=sha-xxxxxxx
SENHA_POSTGRES=
SENHA_MIGRADOR=
SENHA_APP=
SENHA_VERIFICADOR=
# produtor:sha256(token). O token em si vai em AUDITORIA_TOKEN do worker da escola.
# Gerar: T=$(openssl rand -hex 32); echo "token=$T"; echo -n "$T" | sha256sum
AUDITORIA_TOKENS=escola-worker:
